DATABASE_URL="postgresql://postgres:1234@localhost:5432/chrms?schema=public"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_SEC=604800
PORT=3000
# One origin, or comma-separated (Vite often uses 8080 or 8081)
CORS_ORIGIN="http://localhost:8080,http://localhost:8081"
AUTH_MODE=keycloak
KEYCLOAK_URL=https://auth.chirocity.gov.et
KEYCLOAK_REALM=chirocity
KEYCLOAK_CLIENT_ID=chrms-web
KEYCLOAK_AUDIENCE=chrms-api
